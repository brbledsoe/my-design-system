{
  "name": "my-design-system",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "pnpm -r --filter @my-design-system/* build",
    "check": "pnpm -r --filter vue-pilot --filter native-pilot typecheck",
    "verify:tokens": "node --test packages/tokens/test/*.test.mjs",
    "verify:packed": "node scripts/verify-packed.mjs",
    "verify:releases": "node scripts/verify-packed.mjs --rehearse",
    "changeset": "changeset",
    "version:packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "playwright": "^1.56.1"
  }
}
